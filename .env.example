# Which backend the app talks to.
#   mock     -- axios-mock-adapter + localStorage (default; no setup needed)
#   supabase -- the real backend in supabase/
VITE_BACKEND=supabase

# Local stack:  supabase start  (prints these)
# Hosted:       Project Settings -> API
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
